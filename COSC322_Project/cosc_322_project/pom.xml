<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ubc.cosc322</groupId>
    <artifactId>team-00</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>COSC322-Team-00</name>
    <description>COSC 322 Game Player Project</description>
    <inceptionYear>2021</inceptionYear>

    <url>https://people.ok.ubc.ca/yongg</url>
    <developers>
        <developer>
            <id>Team-00</id>
            <name>Team members</name>
            <email></email>
        </developer>
        <developer>
            <id>yg</id>
            <name>Yong Gao</name>
            <email>yong.gao@ubc.ca</email>
        </developer>
    </developers>

    <!--
        All ygraph / SmartFox JARs are referenced directly from the local lib/ folder.
        This bypasses the UBC remote repository which has an SSL certificate mismatch
        (CN=111-bronze.webi.it.ubc.ca vs people.ok.ubc.ca), ensuring the project
        builds offline and VS Code's Java Language Server can resolve all symbols.
    -->
    <dependencies>
        <dependency>
            <groupId>ubc-yong-gao</groupId>
            <artifactId>ygraph-ai-smartfox-client</artifactId>
            <version>2.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/ygraph-ai-smartfox-client-2.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>ubc-yong-gao</groupId>
            <artifactId>ygraph</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/ygraph-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>smartfox.client-libs</groupId>
            <artifactId>SFS2X_API_Java</artifactId>
            <version>1.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/SFS2X_API_Java-1.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>smartfox.client-libs</groupId>
            <artifactId>sfs2x-client-core</artifactId>
            <version>1.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sfs2x-client-core-1.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.jboss.netty</groupId>
            <artifactId>netty</artifactId>
            <version>3.2.5.Final</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/netty-3.2.5.Final.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.6.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/slf4j-api-1.6.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.6.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/slf4j-simple-1.6.1.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>11</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
</project>
